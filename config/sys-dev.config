%% OTP application config for the local ARM-Mac dev node.
%%
%% Selected with RELX_CONFIG_PATH at launch -- the extended start script reads
%% that override before falling back to releases/<vsn>/sys.config, which the
%% dev release does not ship ({sys_config, false} in rebar.config's base relx
%% block). Without a sys.config the node dies before any application starts:
%%
%%   Could not start kernel pid (application_controller)
%%   ("error in config file ".../sys.config" (none):
%%    configuration file not found")
%%
%% The name must end in `.config'. The emulator's -config flag appends
%% `.config' to anything that doesn't already end with it, so the otherwise
%% obvious `sys.config.dev' is unloadable -- erl looks for
%% `sys.config.dev.config' and reports the same "not found" error as having no
%% sys.config at all. Hence sys-dev.config.
%%
%% Pass it as an ABSOLUTE path: the start script cd's to the release root
%% before exec'ing erlexec, so a relative -config resolves from there.
%%
%% Kazoo's own settings do NOT belong here -- they come from the INI named by
%% KAZOO_CONFIG (config/config-dev.ini). This file is only for the OTP
%% applications that read their config the standard way, which in practice
%% means lager.
%%
%% Paths below are relative to the node's working directory. The start script
%% does `cd $ROOTDIR', so they resolve under _build/dev/rel/kazoo/.

[
 {lager, [
          %% kz_log identifies these handlers by exactly these terms --
          %% 'lager_console_backend' and {lager_file_backend, "log/....log"} --
          %% when kazoo_apps_init:set_loglevel/0 applies the [log] section of
          %% config-dev.ini at boot. Renaming a file here silently detaches it
          %% from the INI: kz_log gets {error, bad_module} back and moves on.
          {handlers, [
                      {lager_console_backend,
                       [{level, info}
                       ,{formatter, lager_default_formatter}
                        %% Terser than the default: a dev watching `foreground'
                        %% wants the module:line, not the full date.
                       ,{formatter_config, [time, " [", severity, "] ", pid, " "
                                           ,{module, [module, ":", line, " "], ""}
                                           ,message, "\n"]}
                       ]}
                     ,{lager_file_backend,
                       [{file, "log/console.log"}
                       ,{level, info}
                       ,{size, 10485760}
                       ,{count, 5}
                       ]}
                     ,{lager_file_backend,
                       [{file, "log/error.log"}
                       ,{level, error}
                       ,{size, 10485760}
                       ,{count, 5}
                       ]}
                     ]}
          %% lager's own .app ships {log_root, "log"}, which would prefix every
          %% path below and land the files in log/log/. Neutralise it here
          %% rather than dropping the "log/" prefix from the filenames --
          %% kz_log matches handlers on the literal {lager_file_backend,
          %% "log/console.log"} term, so the prefix has to stay in the config
          %% even though it is really a directory.
         ,{log_root, "."}
         ,{crash_log, "log/crash.log"}
         ,{crash_log_size, 10485760}
         ,{crash_log_count, 5}
          %% Don't drop messages on a burst: a dev node's throughput is low and
          %% a silently truncated log during a debug session is worse than slow.
         ,{error_logger_hwm, 500}
         ]}

 %% sasl is in the release, and its own error logger would double every report
 %% lager already prints. Hand it to lager alone.
,{sasl, [{sasl_error_logger, false}]}
].
