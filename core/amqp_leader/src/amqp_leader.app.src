{application, amqp_leader,
 [
  {description, "a leader for AMQP"},
  {vsn,git},
  {modules, []},
  {registered, [amqp_leader_sup]},
  {applications, [ kernel
                 , stdlib

                 , kazoo_amqp
                 %% amqp_leader_listener gates readiness on kz_nodes:is_up/1,
                 %% so the node registry must be started before this app.
                 , kazoo_globals

                 , lager
                 ]},
  {mod, {amqp_leader_app, []}},
  {env, []}
 ]}.
