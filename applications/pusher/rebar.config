{erl_opts, [warn_export_all
           ,warn_missing_spec
           ,warnings_as_errors
           ,debug_info
           ,{parse_transform, lager_transform}
           ]}.
{xref_checks, [undefined_function_calls
              ,deprecated_function_calls
              ,locals_not_used
              ]}.
{deps, [{apns, {git, "https://github.com/openkazoo/erlang-apns4erl", {ref, "a4af002cf90a8686969fd1767fde0fed852acf3e"}}}
       ,{fcm, {git, "https://github.com/openkazoo/erlang-fcm", {ref, "32e73a9ad2db8fb8ae5ebe1315f59b5cc69a1597"}}}
       ]}.
{eunit_opts, [verbose]}.
{cover_enabled, true}.
{cover_print_enabled, true}.
