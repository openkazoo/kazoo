{erl_opts, [warn_export_all
           ,warn_missing_spec
           ,warnings_as_errors
           ,debug_info
           ,{parse_transform, lager_transform}
           ]}.
{xref_checks, [undefined_function_calls
              ,deprecated_function_calls
              ,locals_not_used
              ]}.
{deps, [{gen_smtp, {git, "https://github.com/openkazoo/erlang-gen_smtp", {ref, "aa45101978aabb38af9156e18ba37b9dc2fa3d83"}}}]}.
{eunit_opts, [verbose]}.
{cover_enabled, true}.
{cover_print_enabled, true}.
