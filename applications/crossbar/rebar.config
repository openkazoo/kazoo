{erl_opts, [warn_export_all
           ,warn_missing_spec
           ,warnings_as_errors
           ,debug_info
           ,{parse_transform, lager_transform}
           ]}.
{xref_checks, [undefined_function_calls
              ,deprecated_function_calls
              ,locals_not_used
              ]}.
{deps, [{ecsv, {git, "https://github.com/openkazoo/erlang-ecsv", {ref, "a36a8bcafa9bb210f51ad04d3f8d5b4298469090"}}}]}.
{eunit_opts, [verbose]}.
{cover_enabled, true}.
{cover_print_enabled, true}.
