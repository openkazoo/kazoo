{
    "$schema": "http://json-schema.org/draft-04/schema#",
    "_id": "kapi.conference.dtmf",
    "description": "AMQP API for conference.dtmf",
    "properties": {
        "Application-Name": {
            "enum": [
                "dtmf"
            ],
            "type": "string"
        },
        "Conference-ID": {
            "type": "string"
        },
        "Digits": {
            "type": [
                "number",
                "string"
            ]
        },
        "Event-Category": {
            "enum": [
                "conference"
            ],
            "type": "string"
        },
        "Event-Name": {
            "enum": [
                "command"
            ],
            "type": "string"
        },
        "Participant-ID": {
            "type": "string"
        }
    },
    "required": [
        "Application-Name",
        "Conference-ID",
        "Digits"
    ],
    "type": "object"
}
