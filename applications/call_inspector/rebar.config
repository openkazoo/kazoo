{erl_opts, [warn_export_all
           ,warn_missing_spec
           ,warnings_as_errors
           ,debug_info
           ,{parse_transform, lager_transform}
           ]}.
{xref_checks, [undefined_function_calls
              ,deprecated_function_calls
              ,locals_not_used
              ]}.
{deps, [{hep, {git, "https://github.com/openkazoo/erlang-hep", {ref, "ba183f2f30845383d48c9d953ccef029b102b378"}}}]}.
{eunit_opts, [verbose]}.
{cover_enabled, true}.
{cover_print_enabled, true}.
